# 默认配置都已写在 src/config.ts，无需创建 .env 即可 npm start。
# 下面内容仅用于本机环境不同或需要临时切换时覆盖默认值。

# PORT=3100
# AGENT_MODEL=provider/model-id
# 拜访 Spring Boot 服务；移动页面仍访问 New-Agent 的同源 /api/visit/*。
# VISIT_API_BASE_URL=http://127.0.0.1:8080
# VISIT_API_TIMEOUT_MS=10000
# 正式环境取消注释后会启用启动安全校验。
# NODE_ENV=production

# 默认使用 MySQL；需要验证文件回退时再取消注释。
# NEW_AGENT_STORAGE=file
# NEW_AGENT_DATA_DIR=data

# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=new_agent
# MYSQL_USER=root
# MYSQL_PASSWORD=本机密码
# MYSQL_CONNECTION_LIMIT=10
# MYSQL_CONNECT_TIMEOUT_MS=5000

# 观测告警阈值：单次运行耗时与成本达到阈值时生成活动告警。
# OBSERVABILITY_ALERT_DURATION_MS=120000
# OBSERVABILITY_ALERT_COST_USD=1
# OBSERVABILITY_STALE_RUN_MS=1800000

# 评测资源上限：单次用例数、每用户存储用例数、单个 Agent 用例输出字符数、单用例 Trial 数。
# EVAL_MAX_CASES_PER_RUN=200
# EVAL_MAX_STORED_CASES=2000
# EVAL_MAX_OUTPUT_CHARS=200000
# EVAL_MAX_TRIALS_PER_CASE=20
# EVAL_MAX_EVIDENCE_BYTES=16777216

# 正式部署时请覆盖 Cookie 签名密钥，并在 HTTPS 环境开启 Secure。
# AUTH_SECRET=至少32位随机字符串
# AUTH_COOKIE_SECURE=true
# AUTH_MAX_AGE_SECONDS=604800
